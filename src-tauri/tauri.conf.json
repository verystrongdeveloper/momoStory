{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MomoStory",
  "version": "1.5.0",
  "identifier": "com.momostory.app",
  "build": {
    "beforeBuildCommand": "npm run desktop:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MomoStory",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RkIyNTgwN0YwRDRCNDQKUldSRVN3MS9nQ1g3RmlrSjZXU0RXaE9lNStHeDNlbW9ZaGpjNXcxWVJoa1BQbmVrQWl4QjVBMDAK",
      "endpoints": [
        "https://github.com/verystrongdeveloper/momoStory/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
