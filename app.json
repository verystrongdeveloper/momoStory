{
  "expo": {
    "name": "MomoStory",
    "slug": "momostory",
    "version": "1.4.5",
    "orientation": "default",
    "scheme": "momostory",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "icon": "./public/icon-512.png",
    "android": {
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "versionCode": 22,
      "package": "com.momostory.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#FB94A7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }],
      [
        "expo-splash-screen",
        {
          "image": "./public/icon-512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
