{
  "name": "momostory",
  "main": "expo-router/entry",
  "version": "1.0.6",
  "scripts": {
    "community:assets": "node scripts/build-community-assets.cjs",
    "test:community": "node scripts/build-community-assets.cjs --check && node scripts/test-community.cjs && node scripts/test-community-client.cjs && node scripts/test-community-ui.cjs",
    "test:editor": "node scripts/test-story-editor.cjs",
    "test:tutorial": "node scripts/test-tutorial.cjs",
    "video:renderer": "node scripts/build-video-renderer.js",
    "test:video": "node scripts/test-video-timeline.cjs && node scripts/test-video-presentation.cjs && node scripts/test-video-assets.cjs && node scripts/test-video-ui.cjs && node scripts/test-background-transition.cjs",
    "test:file-save": "node scripts/test-file-save.cjs && node scripts/test-local-file-save.cjs",
    "test:language": "node scripts/test-generation-language.cjs",
    "test:update": "node scripts/test-app-update.cjs && node scripts/test-settings-version.cjs",
    "test:prompt": "node scripts/test-event-prompt.cjs",
    "test:chat-audio": "node scripts/test-chat-audio.cjs && node scripts/test-chat-sound-picker.cjs",
    "postinstall": "node scripts/build-video-renderer.js",
    "start": "expo start",
    "server": "npm --prefix server start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop:web": "node scripts/export-desktop.js",
    "desktop": "tauri build",
    "desktop:exe": "tauri build --no-bundle && node scripts/place-desktop-exe.js",
    "android:apk": "node scripts/build-android-apk.js",
    "test": "jest --watchAll",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@mediabunny/aac-encoder": "^1.61.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "expo": "~57.0.1",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fontfaceobserver": "^2.3.0",
    "mediabunny": "^1.61.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@electric-sql/pglite": "^0.5.10",
    "@tauri-apps/cli": "^2.12.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "^0.28.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
